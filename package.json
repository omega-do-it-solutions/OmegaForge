{
  "name": "omega-forge",
  "version": "0.3.0",
  "private": true,
  "description": "A lean technical foundation for AI-developed products",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "storage:up": "docker compose --profile storage up -d seaweedfs",
    "storage:down": "docker compose --profile storage down",
    "storage:logs": "docker compose --profile storage logs -f seaweedfs",
    "compose:check": "docker compose --profile storage config --quiet"
  }
}
